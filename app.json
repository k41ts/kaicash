{
  "expo": {
    "name": "KaiCash",
    "slug": "kaicash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/icontransparent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hakaitsu.kaicash"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "3cb2ac04-3bbf-4ee2-985c-4966d3ee1cc1"
      }
    }
  }
}
